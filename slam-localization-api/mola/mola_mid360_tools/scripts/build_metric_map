#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 3 ]]; then
  echo "Usage: ros2 run mola_mid360_tools build_metric_map INPUT.simplemap OUTPUT.mm EXTERNALS_DIR [MODE]"
  echo "MODE: dynamic(default) | dynamic-conservative | dynamic-aggressive | dynamic-debug | plain"
  exit 2
fi
MODE="${4:-dynamic}"
SHARE="$(ros2 pkg prefix --share mola_mid360_tools)"
case "$MODE" in
  dynamic)              CFG="$SHARE/config/sm2mm_mid360_dynamic_filter.yaml" ;;
  dynamic-conservative) CFG="$SHARE/config/sm2mm_mid360_dynamic_filter_conservative.yaml" ;;
  dynamic-aggressive)   CFG="$SHARE/config/sm2mm_mid360_dynamic_filter_aggressive.yaml" ;;
  dynamic-debug)        CFG="$SHARE/config/sm2mm_mid360_dynamic_filter_debug.yaml" ;;
  plain)                CFG="$SHARE/config/sm2mm_no_decim_imu_mls_keyframe_map.yaml" ;;
  *) echo "Unknown MODE: $MODE"; exit 2 ;;
esac
exec sm2mm -i "$1" -o "$2" -p "$CFG" --externals-dir "$3"
