#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 1 ]]; then
  echo "Usage: ros2 run mola_mid360_tools run_rosbag_localization MAP.mm [LIDAR_TOPIC] [IMU_TOPIC]"
  exit 2
fi
MAP_FILE="$(realpath "$1")"
LIDAR_TOPIC="${2:-/livox/lidar}"
IMU_TOPIC="${3:-/livox/imu}"
exec ros2 launch mola_mid360_tools mid360_localization_rosbag.launch.py \
  map_file:="$MAP_FILE" lidar_topic:="$LIDAR_TOPIC" imu_topic:="$IMU_TOPIC"
